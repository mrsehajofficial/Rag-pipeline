# rag-pipeline environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control (it is already in .gitignore).

# ---- Security (required for non-local deployments) -----------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
RAG_API_KEY=

# ---- Embedding provider --------------------------------------------------
# hashing  -> offline, deterministic (dev/CI only, not semantic)
# local    -> ONNX on CPU, no key needed (pip install onnxruntime tokenizers)
# openai   -> API-based, requires OPENAI_API_KEY
RAG_EMBED_PROVIDER=hashing
RAG_EMBED_MODEL=text-embedding-3-small

# ---- LLM provider --------------------------------------------------------
# extractive -> offline sentence-extraction (dev/CI)
# openai     -> API-based, requires OPENAI_API_KEY
RAG_LLM_PROVIDER=extractive
RAG_LLM_MODEL=gpt-4o-mini

# ---- OpenAI credentials (needed when provider=openai) --------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Server --------------------------------------------------------------
RAG_PORT=8000
RAG_RATE_LIMIT_RPS=10
RAG_RATE_LIMIT_BURST=20
RAG_MAX_QUERY_CHARS=2000

# ---- Retrieval tuning ----------------------------------------------------
RAG_TOP_K=8
RAG_RERANK=true
RAG_MMR_LAMBDA=0.7

# ---- Observability -------------------------------------------------------
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=false
